local function isInZone1()
    local char = Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local p = root.Position
        return (p.X >= z1_minX and p.X <= z1_maxX) and (p.Y >= z1_minY and p.Y <= z1_maxY) and (p.Z >= z1_minZ and p.Z <= z1_maxZ)
    end
    return false
end

local function isInZone2()
    local char = Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local p = root.Position
        return (p.X >= z2_minX and p.X <= z2_maxX) and (p.Y >= z2_minY and p.Y <= z2_maxY) and (p.Z >= z2_minZ and p.Z <= z2_maxZ)
    end
    return false
end

local function waitToTeleport()
    while isInZone1() do
        task.wait()
        if isInZone2() then return end
    end
    local timeLeft = 0.5 
    while timeLeft > 0 do
        task.wait(0.05)
        timeLeft = timeLeft - 0.05
        if isInZone2() then break end
    end
end

